{
  "_id": "{{@ system @}}",
  "headers": {
    "Authorization": "bearer $SECRET(jwt_access_token)"
  },
  "json_content_types": [
    "text/json",
    "text/xml"
  ],
  "operations": {
    "person-insert": {
      "headers": {
        "Content-Type": "application/json-patch+json",
        "accept": "text/json"
      },
      "method": "POST",
      "url": "Persons"
    },
    "person-list": {
      "id_expression": "{{ PersonId }}",
      "method": "GET",
      "url": "Persons"
    },
    "person-lookup": {
      "method": "GET",
      "url": "Persons/{{ entity.PersonId }}"
    }
  },
  "type": "system:rest",
  "url_pattern": "https://api.webcrm.com/%s",
  "verify_ssl": true
}