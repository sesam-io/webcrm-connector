{
  "_id": "{{@ system @}}",
  "headers": {
    "Authorization": "bearer $SECRET(jwt_access_token)"
  },
  "operations": {
    "delivery-insert": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json"
      },
      "method": "POST",
      "parse_response_as": "json",
      "url": "Deliveries"
    },
    "delivery-lookup": {
      "method": "GET",
      "url": "Deliveries/{{ entity.DeliveryId }}"
    },
    "delivery-update": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json"
      },
      "method": "PATCH",
      "parse_response_as": "json",
      "url": "Deliveries"
    },
    "deliveryquery-list": {
      "id_expression": "{{ DeliveryId }}",
      "method": "GET",
      "next_page_link": "Queries",
      "next_page_termination_strategy": [
        "empty-result"
      ],
      "params": {
        "Page": "{% if previous_params.Page is not defined %}1{% else %}{{ previous_params.Page|int+1|int }}{% endif %}",
        "Script": "SELECT* FROM Delivery WHERE DeliveryUpdatedAt >= '{{ since }}'",
        "Size": 50
      },
      "url": "Queries"
    },
    "opportunity-insert": {
      "headers": {
        "Content-Type": "application/json",
