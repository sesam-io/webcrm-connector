{
  "_id": "{{@ system @}}",
  "headers": {
    "Authorization": "bearer $SECRET(jwt_access_token)"
  },
  "json_content_types": [
    "text/json",
    "text/xml"
  ],
  "operations": {
    "person-insert": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "POST",
      "parse_response_as": "json",
      "url": "Persons"
    },
    "person-list": {
      "id_expression": "{{ PersonId }}",
      "method": "GET",
      "url": "Persons?size=1&page=1"
    },
    "person-lookup": {
      "method": "GET",
      "url": "Persons/{{ entity.PersonId }}"
    },
    "person-update": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "PATCH",
      "parse_response_as": "json",
      "url": "Persons"
    },
    "product-insert": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "POST",
      "parse_response_as": "json",
      "url": "Products"
    },
    "product-list": {
      "id_expression": "{{ ProductId }}",
      "method": "GET",
      "url": "Products"
    },
    "product-lookup": {
      "method": "GET",
      "url": "Products/{{ entity.ProductId }}"
    },
    "product-update": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "PATCH",
      "parse_response_as": "json",
      "url": "Products"
    },
    "quotationline-insert": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "POST",
      "parse_response_as": "json",
      "url": "QuotationLines"
    },
    "quotationline-list": {
      "id_expression": "{{ QuotationLineId }}",
      "method": "GET",
      "url": "QuotationLines"
    },
    "quotationline-lookup": {
      "method": "GET",
      "url": "QuotationLines/{{ entity.QuotationLineId }}"
    },
    "quotationline-update": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "PATCH",
      "parse_response_as": "json",
      "url": "QuotationLines"
    },
    "user-insert": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "POST",
      "parse_response_as": "json",
      "url": "Users"
    },
    "user-list": {
      "id_expression": "{{ UserId }}",
      "method": "GET",
      "url": "Users"
    },
    "user-lookup": {
      "method": "GET",
      "url": "Users/{{ entity.UserId }}"
    },
    "user-update": {
      "headers": {
        "Content-Type": "application/json",
        "accept": "application/json",
        "payload-type": "text"
      },
      "method": "PATCH",
      "parse_response_as": "json",
      "url": "Users"
    }
  },
  "type": "system:rest",
  "url_pattern": "https://api.webcrm.com/%s",
  "verify_ssl": true
}